# --- SMTP (email sending) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
SMTP_TLS=1
SMTP_TIMEOUT=30

# Set to 1 to simulate email sending locally (no real emails sent)
SMTP_DRY_RUN=1

# --- Admin bootstrap ---
BDA_ADMIN_USER=
BDA_ADMIN_PASSWORD=

# --- Workers ---
# Set to 1 only if you want the embedded worker in the Streamlit process
ALLOW_EMBEDDED_WORKER=0
